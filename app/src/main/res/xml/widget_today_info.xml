<?xml version="1.0" encoding="utf-8"?>
<!-- '오늘 갈 현장' 위젯 정보. 내용은 ~548dp 고정이라 **셀이 그보다 크면 가운데가 빈다** → 기본을 작게(4x4) 두고
     **세로 리사이즈 허용**(resizeMode vertical)으로 사장님이 내용에 딱 맞게 줄이게 한다. minHeight=548 이 바닥이라 더 줄면 내용이 안 짤린다.
     (2026-11-05 사장님 "위젯 사이즈 이게 맞아" — 4x5 기본이 너무 컸다) 자동 갱신 30분(구글 최소). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="300dp"
    android:minHeight="548dp"
    android:targetCellWidth="4"
    android:targetCellHeight="4"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_today"
    android:previewLayout="@layout/widget_today"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_today_desc" />
