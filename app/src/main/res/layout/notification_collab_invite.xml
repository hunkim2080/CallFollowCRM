<?xml version="1.0" encoding="utf-8"?>
<!--
  🤝 협업 요청 알림(받는 쪽) 커스텀 — 제목 + **라이브 카운트다운 칩**(수락 마감까지) + 현장/일당.
  DecoratedCustomViewStyle 이 위에 앱 머리를 붙이고, 이 뷰가 본문. (2026-11-25 사장님 프로토 SeBrR85)
  ⚠️ RemoteViews 화이트리스트만 — 순수 <View> 금지. 글자색은 알림 TextAppearance 로 테마 적응,
     카운트다운 칩만 항상 호박색(그 위 글자 어둡게 고정). inflate 실패 시 글자 알림으로 폴백.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="2dp"
    android:paddingBottom="6dp"
    android:paddingEnd="8dp">

    <TextView
        android:id="@+id/ci_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="협업 요청이 왔어요"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
        android:textStyle="bold"
        android:textSize="15sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- ⏳ 카운트다운 칩 (호박색 알약) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/noti_cd_chip"
        android:paddingStart="11dp"
        android:paddingEnd="11dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="수락 마감  "
            android:textColor="@color/collab_cd_label"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Chronometer
            android:id="@+id/ci_cd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/collab_cd_on"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/ci_site"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Line2"
        android:maxLines="2"
        android:ellipsize="end" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="지나면 요청이 사라져요 · 눌러서 수락"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Line2"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
