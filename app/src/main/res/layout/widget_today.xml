<?xml version="1.0" encoding="utf-8"?>
<!-- 시공막내 '오늘 갈 현장 + 답장 안 함' 위젯 (RemoteViews + 컬렉션 ListView).
     2026-11-05 사장님 개편: 오늘 현장 전부(협업 포함) 리스트, 줄마다 그 고객으로 딥링크,
     길찾기는 '지금 갈 곳' 하나만, 맨 위 ⟳ 새로고침 + 갱신 시각, compact·하단 캡션 제거. -->
<!-- 높이 = wrap_content: 흰 카드가 **내용만큼만** 크고 남는 셀은 투명(배경화면 비침) —
     전엔 match_parent + 리스트 weight=1 이라 현장 2곳이면 아래가 허연 백지였다. (2026-11-05 사장님 "프로토는 이렇게 텅빈적 없어", 프로토 BFrs7Rsr 처럼) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/widget_today_bg"
    android:padding="14dp">

    <!-- ── 답장 안 함 뱃지 (수>0일 때만) — 탭 → 그 고객 대화 ── -->
    <LinearLayout
        android:id="@+id/widget_badge_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="답장 안 함"
                android:textColor="#202E42"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widget_unanswered_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:paddingLeft="11dp"
                android:paddingRight="11dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:background="@drawable/widget_badge_bg"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="›"
                android:textColor="#9AA3B0"
                android:textSize="20sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="9dp">
            <TextView
                android:id="@+id/widget_unanswered_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#202E42"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widget_unanswered_elapsed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="#9AA3B0"
                android:textSize="11sp" />
        </LinearLayout>
        <TextView
            android:id="@+id/widget_unanswered_msg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#64748B"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- ── 답장할 고객 없음(완료) — 미답 수=0 ── -->
    <LinearLayout
        android:id="@+id/widget_badge_done"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">
        <TextView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:background="@drawable/widget_done_bg"
            android:text="✓"
            android:textColor="#087850"
            android:textSize="14sp"
            android:textStyle="bold" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="11dp"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="답장할 고객 없음"
                android:textColor="#202E42"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widget_badge_done_sub2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#9AA3B0"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 구분선 -->
    <FrameLayout
        android:id="@+id/widget_div1"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="#E7EBF1"
        android:visibility="gone" />

    <!-- ── 머리줄: 오늘 갈 현장 · N곳  +  갱신 시각  +  새로고침 ⟳ ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="13dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="오늘 갈 현장"
            android:textColor="#202E42"
            android:textSize="13sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/widget_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:textColor="#9AA3B0"
            android:textSize="11.5sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/widget_synced"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:maxLines="1"
            android:textColor="#AEB6C2"
            android:textSize="10sp" />
        <TextView
            android:id="@+id/widget_refresh"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:background="@drawable/widget_refresh_bg"
            android:text="↻"
            android:textColor="#2368BE"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ── 지금 갈 곳 (하나) — 정적 카드. 탭 → 고객상세/협업. 길찾기 버튼 하나. ── -->
    <LinearLayout
        android:id="@+id/widget_primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="11dp">

        <LinearLayout
            android:id="@+id/widget_site_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_today_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="7dp"
                android:paddingLeft="8dp"
                android:paddingRight="9dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:background="@drawable/widget_chip_bg"
                android:text="● 지금 갈 곳"
                android:textColor="#245FA8"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/widget_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="#202E42"
                    android:textSize="17sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/widget_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="#202E42"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
            <TextView
                android:id="@+id/widget_region"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#5A6472"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/widget_unit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#2368BE"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone" />
            <LinearLayout
                android:id="@+id/widget_memo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp"
                android:paddingLeft="9dp"
                android:paddingRight="9dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:background="@drawable/widget_memo_bg"
                android:visibility="gone">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="현장 메모"
                    android:textColor="#8A5D14"
                    android:textSize="10sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/widget_memo_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:textColor="#5A4A2A"
                    android:textSize="12sp" />
            </LinearLayout>
            <TextView
                android:id="@+id/widget_worktype"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#087B58"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_open"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="12dp"
            android:paddingTop="13dp"
            android:paddingBottom="13dp"
            android:background="@drawable/widget_today_btn">
            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_widget_nav" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="길찾기"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- ── 이따 갈 곳 (스크롤 리스트) ── -->
    <TextView
        android:id="@+id/widget_sub_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:text="이따 갈 곳"
        android:textColor="#9AA3B0"
        android:textSize="10sp"
        android:textStyle="bold"
        android:visibility="gone" />
    <!-- 높이 = wrap_content(weight 제거): 내용만큼만 → 흰 카드가 안 늘어나 백지 안 생김.
         셀보다 길면 호스트가 AT_MOST 로 묶어 스크롤된다(많을 때만). (2026-11-05 사장님) -->
    <ListView
        android:id="@+id/widget_today_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:divider="#F0F2F5"
        android:dividerHeight="1dp"
        android:scrollbars="none"
        android:visibility="gone" />
    <TextView
        android:id="@+id/widget_empty_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <!-- ── 빈 날 ── -->
    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="오늘 갈 현장이 없어요"
        android:textColor="#64748B"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
