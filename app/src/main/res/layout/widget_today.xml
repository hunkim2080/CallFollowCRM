<?xml version="1.0" ?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/widget_today_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="117dp" android:orientation="vertical" android:id="@+id/widget_reply" android:gravity="center_vertical" android:paddingLeft="16dp" android:paddingRight="16dp" android:paddingTop="13dp" android:paddingBottom="13dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="27dp" android:layout_height="27dp" android:text="✓" android:textSize="15sp" android:textColor="#087850" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:id="@+id/widget_reply_check" android:gravity="center" android:background="@drawable/widget_done_bg"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="답장 안 함" android:textSize="15sp" android:textColor="#213047" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:id="@+id/widget_reply_title" android:textStyle="bold" android:layout_marginLeft="9dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2건" android:textSize="22sp" android:textColor="#FFFFFF" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:id="@+id/widget_unanswered_count" android:background="@drawable/widget_badge_bg" android:paddingLeft="9dp" android:paddingRight="9dp" android:layout_marginLeft="9dp"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="›" android:textSize="19sp" android:textColor="#9AA3B0" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:layout_weight="1" android:gravity="right"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/widget_reply_preview" android:layout_marginTop="7dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="이름 미등록 고객" android:textSize="11.5sp" android:textColor="#213047" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:id="@+id/widget_unanswered_name" android:textStyle="bold" android:layout_weight="1"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="11.5sp" android:textColor="#9AA3B0" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:id="@+id/widget_unanswered_elapsed" android:layout_marginLeft="6dp"/>
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="11.5sp" android:textColor="#69788C" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:id="@+id/widget_unanswered_msg" android:layout_marginTop="2dp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/widget_reply_done" android:layout_marginTop="7dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="고객 답장을 모두 챙겼어요." android:textSize="11.5sp" android:textColor="#087850" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="이제 오늘 현장을 확인해 보세요." android:textSize="11.5sp" android:textColor="#69788C" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:id="@+id/widget_reply_done_sub" android:layout_marginTop="2dp"/>
        </LinearLayout>
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="1dp" android:background="#E6ECF3"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:orientation="vertical" android:layout_weight="1" android:paddingLeft="16dp" android:paddingRight="16dp" android:paddingTop="9dp" android:paddingBottom="13dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="9dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="오늘 갈 현장" android:textSize="13sp" android:textColor="#213047" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:id="@+id/widget_today_label" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="10sp" android:textColor="#69788C" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:id="@+id/widget_count" android:layout_marginLeft="6dp"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="방금" android:textSize="10sp" android:textColor="#9AA3B0" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:id="@+id/widget_synced" android:layout_weight="1" android:gravity="right" android:textStyle="bold"/>
            <TextView android:layout_width="30dp" android:layout_height="30dp" android:text="⟳" android:textSize="12sp" android:textColor="#2165C4" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:id="@+id/widget_refresh" android:gravity="center" android:contentDescription="새로고침" android:background="@drawable/widget_refresh_bg" android:layout_marginLeft="7dp"/>
        </LinearLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:id="@+id/widget_primary">
                <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:id="@+id/widget_site_card" android:layout_weight="1" android:background="@drawable/widget_site_card_bg">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:id="@+id/widget_card_content">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="6dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="● 지금 시공" android:textSize="10sp" android:textColor="#245FA8" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:id="@+id/widget_today_chip" android:background="@drawable/widget_chip_bg" android:paddingLeft="8dp" android:paddingRight="8dp" android:paddingTop="1dp" android:paddingBottom="1dp" android:textStyle="bold"/>
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="" android:textSize="10sp" android:textColor="#6246EA" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:id="@+id/widget_collab_chip" android:layout_weight="1" android:layout_marginLeft="5dp" android:background="@drawable/widget_collab_chip_bg" android:paddingLeft="8dp" android:paddingRight="8dp" android:paddingTop="1dp" android:paddingBottom="1dp" android:textStyle="bold"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="" android:textSize="16sp" android:textColor="#1C3B60" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:id="@+id/widget_name" android:layout_weight="1" android:textStyle="bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="16sp" android:textColor="#213047" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:id="@+id/widget_time" android:textStyle="bold" android:layout_marginLeft="8dp"/>
                        </LinearLayout>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="11sp" android:textColor="#667E98" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:id="@+id/widget_region" android:layout_marginTop="5dp"/>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/widget_featured_address" android:layout_marginTop="8dp" android:paddingRight="62dp">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="12sp" android:textColor="#213047" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:id="@+id/widget_complex" android:textStyle="bold"/>
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="23sp" android:textColor="#2368BE" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:id="@+id/widget_unit" android:textStyle="bold" android:layout_marginTop="2dp"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/widget_compact_address" android:layout_marginTop="2dp">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="12sp" android:textColor="#213047" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:id="@+id/widget_compact_complex" android:textStyle="bold"/>
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="15sp" android:textColor="#2368BE" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:id="@+id/widget_compact_unit" android:textStyle="bold" android:layout_marginTop="1dp"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:id="@+id/widget_memo" android:background="@drawable/widget_memo_bg" android:paddingLeft="9dp" android:paddingRight="9dp" android:paddingTop="7dp" android:paddingBottom="7dp" android:layout_marginTop="8dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="현장 메모" android:textSize="10sp" android:textColor="#8A5D14" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textStyle="bold"/>
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="" android:textSize="11sp" android:textColor="#213047" android:includeFontPadding="false" android:maxLines="2" android:ellipsize="end" android:id="@+id/widget_memo_text" android:layout_weight="1" android:layout_marginLeft="8dp"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:id="@+id/widget_items" android:layout_marginTop="7dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="시공부위" android:textSize="11sp" android:textColor="#69788C" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"/>
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="" android:textSize="11sp" android:textColor="#213047" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:id="@+id/widget_items_text" android:layout_weight="1" android:layout_marginLeft="8dp"/>
                        </LinearLayout>
                    </LinearLayout>
                    <ImageView android:id="@+id/widget_motif" android:layout_width="54dp" android:layout_height="58dp" android:layout_gravity="bottom|right" android:layout_marginRight="12dp" android:layout_marginBottom="12dp" android:src="@drawable/ic_widget_buildings" android:importantForAccessibility="no"/>
                </FrameLayout>
                <TextView android:layout_width="match_parent" android:layout_height="42dp" android:text="길찾기" android:textSize="13sp" android:textColor="#FFFFFF" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:id="@+id/widget_open" android:gravity="center" android:layout_marginTop="9dp" android:background="@drawable/widget_today_btn" android:textStyle="bold" android:drawableStart="@drawable/ic_widget_nav" android:drawablePadding="7dp" android:paddingLeft="16dp" android:paddingRight="16dp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:id="@+id/widget_empty">
                <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:orientation="vertical" android:layout_weight="1" android:gravity="center" android:background="@drawable/widget_empty_bg" android:padding="12dp">
                    <TextView android:layout_width="36dp" android:layout_height="36dp" android:text="✓" android:textSize="20sp" android:textColor="#087850" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:gravity="center" android:background="@drawable/widget_done_bg"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="오늘 갈 현장이 없어요" android:textSize="14sp" android:textColor="#213047" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:id="@+id/widget_empty_title" android:textStyle="bold" android:layout_marginTop="10dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="11sp" android:textColor="#69788C" android:includeFontPadding="false" android:maxLines="2" android:ellipsize="end" android:id="@+id/widget_empty_sub" android:gravity="center" android:layout_marginTop="7dp"/>
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="42dp" android:text="일정 보기" android:textSize="13sp" android:textColor="#2165C4" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:id="@+id/widget_schedule" android:gravity="center" android:layout_marginTop="9dp" android:background="@drawable/widget_secondary_btn" android:textStyle="bold" android:drawableStart="@drawable/ic_widget_nav" android:drawablePadding="7dp" android:paddingLeft="16dp" android:paddingRight="16dp"/>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="1dp" android:background="#E6ECF3"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="99dp" android:orientation="vertical" android:id="@+id/widget_next" android:gravity="center_vertical" android:paddingLeft="16dp" android:paddingRight="16dp" android:paddingTop="13dp" android:paddingBottom="13dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="이어서" android:textSize="11sp" android:textColor="#69788C" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:id="@+id/widget_next_label" android:textStyle="bold" android:layout_weight="1"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textSize="15sp" android:textColor="#9AA3B0" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="7dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="협업" android:textSize="10sp" android:textColor="#6246EA" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:id="@+id/widget_next_collab" android:background="@drawable/widget_collab_chip_bg" android:paddingLeft="8dp" android:paddingRight="8dp" android:paddingTop="1dp" android:paddingBottom="1dp" android:textStyle="bold"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="" android:textSize="12sp" android:textColor="#213047" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:id="@+id/widget_next_name" android:textStyle="bold" android:layout_weight="1" android:layout_marginLeft="5dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="12sp" android:textColor="#213047" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:id="@+id/widget_next_time" android:textStyle="bold" android:layout_marginLeft="8dp"/>
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="10sp" android:textColor="#69788C" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:id="@+id/widget_next_sub" android:layout_marginTop="2dp"/>
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="1dp" android:background="#E6ECF3"/>
    <TextView android:layout_width="match_parent" android:layout_height="46dp" android:text="🏠 집으로 길찾기" android:textSize="12.5sp" android:textColor="#2165C4" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:id="@+id/widget_home" android:gravity="center" android:textStyle="bold" android:background="@drawable/widget_home_bg"/>
</LinearLayout>
