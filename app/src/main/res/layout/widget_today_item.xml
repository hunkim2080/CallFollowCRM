<?xml version="1.0" encoding="utf-8"?>
<!-- '이따 갈 곳' 한 줄 (컬렉션 위젯 아이템). 탭 → 그 고객 상세(내 건) 또는 협업 현장(협업).
     길찾기 버튼은 여기 없다 — '지금 갈 곳'(정적 카드)에만 하나. (2026-11-05 사장님) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="9dp"
    android:paddingBottom="9dp"
    android:paddingLeft="2dp"
    android:paddingRight="2dp"
    android:background="@drawable/widget_item_ripple">

    <TextView
        android:id="@+id/widget_item_time"
        android:layout_width="52dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="#2368BE"
        android:textSize="11sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/widget_item_collab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:paddingLeft="5dp"
                android:paddingRight="5dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:background="@drawable/widget_collab_chip_bg"
                android:text="협업"
                android:textColor="#6246EA"
                android:textSize="9sp"
                android:textStyle="bold"
                android:visibility="gone" />
            <TextView
                android:id="@+id/widget_item_title"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#202E42"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
        <TextView
            android:id="@+id/widget_item_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#8A94A3"
            android:textSize="10.5sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_item_done"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="7dp"
        android:text="완료"
        android:textColor="#9AA3B0"
        android:textSize="9.5sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
