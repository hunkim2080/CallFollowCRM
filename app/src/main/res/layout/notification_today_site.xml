<?xml version="1.0" encoding="utf-8"?>
<!--
  📍 오늘의 현장 알림(현장 1곳) 커스텀 배너 — 왼쪽 청록 바 + 동호수 크게/밑줄 + 도로명 + 시각.
  DecoratedCustomViewStyle 이 위에 앱 머리(아이콘·시각)를 붙이고, 이 뷰가 본문이 된다.
  ⚠️ 글자색은 알림 전용 TextAppearance 로 **테마(라이트/다크) 자동 적응** — 하드코딩 금지(다크폰에서 안 보임).
     동호수만 코드에서 today_accent 색+밑줄 span 으로 강조한다. (2026-11-25 사장님)
  그리기 실패(기기별 inflate)면 NotificationHelper 가 글자 알림으로 폴백(안 깨짐).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="2dp"
    android:paddingBottom="6dp"
    android:paddingEnd="8dp">

    <!-- 왼쪽 청록 세로 바 -->
    <View
        android:layout_width="5dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="12dp"
        android:background="@color/today_accent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 동호수(크게·굵게) — 동/호 부분만 코드에서 청록+밑줄 -->
        <TextView
            android:id="@+id/today_big"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
            android:textStyle="bold"
            android:textSize="18sp"
            android:maxLines="2"
            android:ellipsize="end" />

        <!-- 도로명/지역 -->
        <TextView
            android:id="@+id/today_road"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Line2"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- 시각 · 안내 -->
        <TextView
            android:id="@+id/today_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Line2"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
