<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Phase 2 permissions
        - READ_PHONE_STATE: 통화 상태(끝남) 감지
        - READ_CALL_LOG: 통화 종료 직후 최근 통화번호 조회
        - POST_NOTIFICATIONS: Android 13+ 알림 표시
        - READ_SMS: 고객 상세 화면에서 갤럭시 메시지로 받은 문자 표시 전용.
        - SEND_SMS: 처음 연락온 고객에게 자동 응답 문자 발송 전용 (Settings 토글 ON 시).
                    사장님 정책으로 Phase 1 한정 추가됨. 직원이 명시 허용해야 발송.
                    10초 카운트다운 동안 알림 취소 가능.
    -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <!--
        READ_CONTACTS (선택 권한, 2026-07-21 사장님) — 삼성 연락처에 저장된 이름을 시공막내에 "그대로 반영".
        번호로 저장된 이름만 조회해 표시용으로만 씀(ContactNameResolver). 없어도 앱은 번호/자체저장 이름으로 정상 동작.
        Play 데이터안전: 연락처는 로컬 표시용, 서버 전송/저장 안 함.
    -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <!--
        고객 SMS 수신 즉시 맥미니 서버에 답변 추천 준비 요청 (Phase 1 / SmsReceiver).
        READ_SMS 와 같은 SMS 권한 그룹이라 한 번 허용 시 동반 허용 가능하지만 명시 선언 필요.
    -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <!--
        2026-05-29 킬러콘텐츠 (MMS 알림) Phase A 1단계 — 기본 SMS 앱 자격 인프라.
        WRITE_SMS: default SMS 앱일 때 시스템 SMS provider 에 INSERT 책임.
        RECEIVE_MMS / RECEIVE_WAP_PUSH: MMS 수신 broadcast 수신. 1단계는 stub.
        실제 default 전환은 2단계 (MMS 본격) 끝난 후 Settings 토글로 (현재 토글 disabled 회색 표시).
    -->
    <uses-permission android:name="android.permission.WRITE_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_MMS" />
    <uses-permission android:name="android.permission.RECEIVE_WAP_PUSH" />
    <!-- 예약 확정 시 축하 진동 (normal permission, 런타임 요청 불필요) -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!--
        ⚠️ 포그라운드 서비스(FGS) 권한 강제 제거 (2026-08-31) — 우리 앱은 FGS 를 실제로 안 씀(startForeground/setForeground/ForegroundInfo 코드 0개).
        WorkManager(work-runtime, 알림 예약용)가 FOREGROUND_SERVICE 를 자동 병합하는데, 이게 Play 업로드 시
        "앱이 FGS 권한을 쓰는지 신고하라"는 검문(Play Console > 앱 콘텐츠 선언)을 트리거 → 업로드 거부(#142 실패 원인).
        실제 미사용이므로 병합된 권한을 tools:node="remove" 로 뽑아 검문 자체를 원천 차단.
        (SPECIAL_USE 는 스크리닝 CallOverlayService 제거로 이미 소스에서 빠졌으나 방어적으로 함께 remove.)
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" tools:node="remove" />
    <!--
        전화 오는 순간 "상대 정보 카드"를 통화화면 위에 띄우기 (2026-07-01 사장님) — 벨 울릴 때
        번호로 고객·시공일정·최근 대화를 즉시 조회해 화면 위에 카드로. 사용자가 설정에서 켜고
        "다른 앱 위에 표시"를 허용해야만 뜬다. (특수 권한 — Settings.canDrawOverlays 로 확인/요청)
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 사진 선택은 시스템 사진 선택기(Photo Picker)로만 — READ_MEDIA_IMAGES 제거(Play 정책: 가끔 쓰는 이미지 선택은 권한 없이 Photo Picker). (2026-07-05)
         아래 READ_EXTERNAL_STORAGE(<=32) 는 구형 기기(갤S9 등)의 통화녹음(오디오) 스캔용으로 유지. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!--
        통화녹음 자동 찾기 (2026-06-30) — 오디오 권한 한 번 허용하면 MediaStore 에서 통화녹음(.m4a)을 앱이
        알아서 찾는다(폴더 직접 선택 불필요 — 연세 있으신 분 배려). 33+ 는 READ_MEDIA_AUDIO, 그 이하는 위 READ_EXTERNAL_STORAGE.
        통화 내용 요약(핵심 기능)에만 사용. 사용자가 "자동으로 찾기" 누를 때만 런타임 요청.
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <!-- 현장 도착 안내(지오펜싱) — 시공 현장 5km 진입 감지. (foreground 위치만)
         ⚠️ ACCESS_BACKGROUND_LOCATION 은 2026-06-19 베타(Play 비공개 테스트) 출시 위해 제거.
            이유: Play 의 백그라운드 위치 선언 + 데모영상 심사를 피하기 위함. 도착 안내는 앱이 열려
            있을 때만 동작(geofence 는 foreground 위치로 등록). 정식 출시 때 데모영상 만들어 다시 추가 예정. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!--
        klinker/android-smsmms 가 MMS 직접 발송 시 통신사 게이트웨이 호출용으로 요구하는 권한들.
        사진 첨부 메시지를 우리 앱 안에서 끝내기 위함 (chooser/수신인 선택 X).
        모두 normal 권한이라 런타임 다이얼로그 X.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <queries>
        <!-- ACTION_SENDTO smsto: 기본 문자앱 탐색용 -->
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <!-- 첨부 사진과 함께 보내기: ACTION_SEND image/* 받는 앱 탐색 -->
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="image/*" />
        </intent>
        <!--
            카드 펼침 [📍 길찾기] → 외부 네비 앱 launch (Android 11+ package visibility).
            사장님이 설정에서 고른 앱 1개만 호출하지만 deeplink 안정성을 위해 3개 다 declare.
            geo: 스키마 (좌표 없을 때 시스템 chooser fallback) 도 포함.
        -->
        <package android:name="com.locnall.KimGiSa" />      <!-- 카카오내비 -->
        <package android:name="com.nhn.android.nmap" />     <!-- 네이버지도 -->
        <package android:name="com.skt.tmap.ku" />          <!-- 티맵 -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
    </queries>

    <application
        android:name=".CallFollowCrmApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.CallFollowCRM">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.CallFollowCRM"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Phase 3: 다른 앱(파일관리자/에이닷 등)에서 audio 파일 공유받기 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>

            <!-- 에이닷 통화요약 화면의 공유(↑) → text/plain 수신.
                 받은 텍스트를 AdotSummaryImporter 로 파싱·저장한다. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!--
                2026-05-29 Default SMS 앱 자격 컴포넌트 (4/4) — ACTION_SENDTO.
                외부 앱 (연락처/다이얼러) 이 "sms:01012345678" 으로 launch 할 때 RING-GO 가 candidate 로 뜨려면 필요.
                Default 일 때 자동으로 이게 호출됨. MainActivity 가 EXTRA_PHONE_NUMBER 받아 ChatScreen 으로 trampoline.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SENDTO" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>

            <!--
                2026-06-08 협업 현장 공유 App Link.
                다른 사장님이 보낸 https://api.si0in.kr/shared/{share_id} (또는 si0in.kr) 를
                브라우저 거치지 않고 RING-GO 가 바로 열어 협업 현장 화면으로 (MainActivity.handleIncoming).
                autoVerify=true → 서버 /.well-known/assetlinks.json 에 릴리즈 SHA256 등록 필요.
                pathPrefix="/shared/" — Android pathPattern 의 '*' 의미가 달라 prefix 로 매칭(= /shared/모든것).
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="api.si0in.kr" />
                <data android:host="si0in.kr" />
                <data android:pathPrefix="/shared/" />
                <!-- 2026-08-13 시공막내 웹 QR 로그인: 노트북 웹이 띄운 https://api.si0in.kr/web/authorize?t=…
                     QR 을 폰 카메라로 찍으면 브라우저 대신 앱이 받아 authorize 호출(폰=열쇠). -->
                <data android:pathPrefix="/web/" />
            </intent-filter>

            <!--
                협업 링크 웹 페이지 fallback.
                App Link 검증이 ask 상태거나 브라우저로 열린 경우 서버가 shigongmagne://shared/{share_id}
                를 시도하므로, 앱이 설치된 사장님은 설치 안내 대신 협업 현장으로 들어가게 받는다.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="shigongmagne" android:host="shared" />
            </intent-filter>
        </activity>

        <!--
            Phase 2: 통화 상태 변경 BroadcastReceiver
            android.intent.action.PHONE_STATE는 정적 등록은 Android 8.0+에서 동작은 하지만
            제조사/OS에 따라 백그라운드 제한이 있을 수 있다.
            안정성을 위해 Application에서 TelephonyManager listener를 함께 등록한다.
        -->
        <receiver
            android:name=".service.CallStateReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>

        <!-- 동의문·처리방침 앱 내 웹뷰 (외부 브라우저 없이 표시). 내부 전용. (2026-07-11) -->
        <activity
            android:name=".presentation.screen.web.DocWebViewActivity"
            android:exported="false"
            android:theme="@style/Theme.CallFollowCRM" />

        <!-- 자동 응답 문자 알림의 "취소" 액션 수신. 내부 전용이라 exported=false. -->
        <receiver
            android:name=".service.AutoReplyCancelReceiver"
            android:exported="false" />

        <!--
            고객 SMS 수신 즉시 맥미니 서버에 답변 추천 준비 요청 (Phase 1).

            2개 액션 listen:
              - SMS_RECEIVED : default 가 아닐 때 받음 (현재 동작, 시스템 갤메시지가 DB INSERT 책임).
              - SMS_DELIVER  : default 일 때만 받음. 받으면 RING-GO 가 SMS provider DB INSERT 책임.
                               2026-05-29 1단계 인프라. 사장님이 Settings 토글 켜야 default 됨 (토글은 2단계 끝까지 disabled 회색).
        -->
        <receiver
            android:name=".service.SmsReceiver"
            android:exported="true"
            android:enabled="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_DELIVER" />
            </intent-filter>
        </receiver>

        <!--
            2026-07-05 Default SMS 앱 MMS(사진) 수신 — 안드로이드 공식 API 경로 (klinker 수신 버그 우회).
              MmsReceived(WAP_PUSH_DELIVER) → 알림 PDU 파싱 → SmsManager.downloadMultimediaMessage 로 다운로드
              → 완료 시 MmsDownloadedReceiver(explicit PendingIntent) → PDU 파싱·content://mms persist·후속훅.
            ⚠️ permission=BROADCAST_WAP_PUSH 필수 — 없으면 이 앱이 "기본 SMS 앱 자격" 을 잃어 role 지정 자체가 실패함
               (RoleManager 가 4개 필수 컴포넌트의 권한까지 검사). WAP_PUSH_DELIVER 는 시스템만 발사(프레임워크 보호).
            ⚠️ 옛 MmsReceiver→MmsDownloadService(klinker MmsReceivedService 직접 호출) 는 file_path=null NPE 로 사진 유실 → 제거.
        -->
        <receiver
            android:name=".service.MmsReceived"
            android:exported="true"
            android:enabled="true"
            android:permission="android.permission.BROADCAST_WAP_PUSH">
            <intent-filter>
                <action android:name="android.provider.Telephony.WAP_PUSH_DELIVER" />
                <data android:mimeType="application/vnd.wap.mms-message" />
            </intent-filter>
        </receiver>

        <!-- MMS 다운로드 완료 콜백 (MmsReceived 가 만든 explicit PendingIntent 로만 호출). intent-filter 불필요. -->
        <receiver
            android:name=".service.MmsDownloadedReceiver"
            android:exported="false" />

        <!-- MMS 다운로드 임시 PDU 파일 provider — SmsManager 가 여기로 다운로드본을 write. -->
        <provider
            android:name=".service.MmsDownloadFileProvider"
            android:authorities="${applicationId}.mmsdownload"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!--
            Step 2 (2026-05-25): 알림창 빠른 답장 RemoteInput 수신 → SmsManager 직접 발송.
            android:exported="false" — 우리 앱 자체 PendingIntent 만 호출. 외부 트리거 X.
        -->
        <receiver
            android:name=".service.SmsReplyReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.detailline.callfollowcrm.ACTION_SMS_REPLY" />
                <action android:name="com.detailline.callfollowcrm.ACTION_SMS_SEND_SUGGESTION" />
            </intent-filter>
        </receiver>

        <!-- MMS 직접 발송 결과 콜백. 내부 PendingIntent 전용. -->
        <receiver
            android:name=".service.MmsSentReceiver"
            android:exported="false" />

        <!--
            2026-05-29 Default SMS 앱 자격 컴포넌트 (3/4) — RESPOND_VIA_MESSAGE service.
            자동차/스마트워치/시스템 빠른 답장 UI 가 호출하는 headless 서비스.
            schemes: sms, smsto, mms, mmsto — 사용자가 "Can't talk, I'll text" 같은 빠른 응답 보낼 때.

            1단계 (Phase A): stub — 호출 받아도 무동작. 사장님 동선엔 영향 0 (사장님은 RING-GO 안에서 답장).
            존재 자체가 default 자격 요건이라 박아둠.
        -->
        <service
            android:name=".service.SmsHeadlessSendService"
            android:exported="true"
            android:permission="android.permission.SEND_RESPOND_VIA_MESSAGE">
            <intent-filter>
                <action android:name="android.intent.action.RESPOND_VIA_MESSAGE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </service>

        <!-- 현장 도착 지오펜스 전이 수신. exported=false — 시스템 Geofencing 만 trigger. -->
        <receiver
            android:name=".service.GeofenceBroadcastReceiver"
            android:exported="false" />

        <!-- FCM 즉시 푸시 수신(협업 요청/진행). data 메시지 → 직접 알림. docs/SERVER_HANDOFF_fcm_push.md -->
        <service
            android:name=".service.RingGoFcmService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- 견적서(직인) 이미지를 문자/공유로 내보낼 때 캐시 파일 URI 공유용. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 통화 스크리닝 — 새 안드로이드(10+)서 벨 중 수신번호 확보용(전화 안 막고 정보만 얹음). ROLE_CALL_SCREENING 보유 시만 호출. (2026-08-27 사장님) -->
        <service
            android:name=".service.IncomingCallScreeningService"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <!-- 알림 '복사' 액션(인증번호 원탭 복사) 처리. (2026-09-01 사장님) -->
        <receiver
            android:name=".service.CopyToClipboardReceiver"
            android:exported="false" />

    </application>
</manifest>
