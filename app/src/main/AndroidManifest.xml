<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Phase 2 permissions
        - READ_PHONE_STATE: 통화 상태(끝남) 감지
        - READ_CALL_LOG: 통화 종료 직후 최근 통화번호 조회
        - POST_NOTIFICATIONS: Android 13+ 알림 표시
        - READ_SMS: 고객 상세 화면에서 갤럭시 메시지로 받은 문자 표시 전용.
        - SEND_SMS: 처음 연락온 고객에게 자동 응답 문자 발송 전용 (Settings 토글 ON 시).
                    사장님 정책으로 Phase 1 한정 추가됨. 직원이 명시 허용해야 발송.
                    10초 카운트다운 동안 알림 취소 가능.
    -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <!--
        고객 SMS 수신 즉시 맥미니 서버에 답변 추천 준비 요청 (Phase 1 / SmsReceiver).
        READ_SMS 와 같은 SMS 권한 그룹이라 한 번 허용 시 동반 허용 가능하지만 명시 선언 필요.
    -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <!-- 예약 확정 시 축하 진동 (normal permission, 런타임 요청 불필요) -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!--
        통화 직후 PostCallCard 오버레이 표시 (첫 통화 한정).
        사용자가 설정 → 다른 앱 위에 표시 토글 직접 켜야 동작.
        미허용 시 기존 AutoReplyScheduler 알림 fallback.
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!--
        klinker/android-smsmms 가 MMS 직접 발송 시 통신사 게이트웨이 호출용으로 요구하는 권한들.
        사진 첨부 메시지를 우리 앱 안에서 끝내기 위함 (chooser/수신인 선택 X).
        모두 normal 권한이라 런타임 다이얼로그 X.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <queries>
        <!-- ACTION_SENDTO smsto: 기본 문자앱 탐색용 -->
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <!-- 첨부 사진과 함께 보내기: ACTION_SEND image/* 받는 앱 탐색 -->
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="image/*" />
        </intent>
    </queries>

    <application
        android:name=".CallFollowCrmApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.CallFollowCRM">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.CallFollowCRM"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Phase 3: 다른 앱(파일관리자/에이닷 등)에서 audio 파일 공유받기 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>

            <!-- 에이닷 통화요약 화면의 공유(↑) → text/plain 수신.
                 받은 텍스트를 AdotSummaryImporter 로 파싱·저장한다. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!--
            Phase 2: 통화 상태 변경 BroadcastReceiver
            android.intent.action.PHONE_STATE는 정적 등록은 Android 8.0+에서 동작은 하지만
            제조사/OS에 따라 백그라운드 제한이 있을 수 있다.
            안정성을 위해 Application에서 TelephonyManager listener를 함께 등록한다.
        -->
        <receiver
            android:name=".service.CallStateReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>

        <!-- 자동 응답 문자 알림의 "취소" 액션 수신. 내부 전용이라 exported=false. -->
        <receiver
            android:name=".service.AutoReplyCancelReceiver"
            android:exported="false" />

        <!--
            고객 SMS 수신 즉시 맥미니 서버에 답변 추천 준비 요청 (Phase 1).
            기본 SMS 앱 아니어도 SMS_RECEIVED broadcast 수신 가능 (Android 7+).
            RECEIVE_SMS 권한 필요.
        -->
        <receiver
            android:name=".service.SmsReceiver"
            android:exported="true"
            android:enabled="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
