# Android 표준 ignore (Android Studio Project Template 기준)
*.iml
.gradle
/local.properties
/.idea
/.idea/caches
/.idea/libraries
/.idea/modules.xml
/.idea/workspace.xml
/.idea/navEditor.xml
/.idea/assetWizardSettings.xml
.DS_Store
/build
/captures
.externalNativeBuild
.cxx
local.properties

# Kotlin / Gradle
.kotlin/
*.hprof

# 빌드 산출물
**/build/
**/out/

# 환경별 키 / 비밀
*.keystore
*.jks
keystore.properties
secrets.properties

# versionCode 자동증가 카운터 (release 빌드마다 +1, 로컬 빌드 상태) — pull 충돌 방지로 git 제외. keystore 와 함께 백업 권장.
version.properties

# Firebase (FCM) — google-services.json = 앱 설정, adminsdk json = 서버 비밀키. 둘 다 git 금지.
/firebase/
app/google-services.json
*-adminsdk-*.json
google-services.json

# Logs
*.log

# OS
Thumbs.db
ehthumbs.db
Desktop.ini

# IDE / Editor
.vscode/
*.swp
*.swo

# Claude Code 산출물 (다른 PC 에서 다시 빌드되거나 별도 동기화)
.claude/

# RING-GO 폰 자동 확인 도구 부산물 (스크린샷 / DB dump — 개인정보 포함)
/scripts/screens/
/scripts/.dbpull/
