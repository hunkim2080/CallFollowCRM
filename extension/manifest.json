{
  "manifest_version": 3,
  "name": "시공막내 — 네이버 블로그 넣기",
  "version": "0.1.1",
  "description": "시공막내에서 만든 글을 네이버 블로그 글쓰기 창에 자동으로 넣어줍니다.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["https://blog.naver.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "시공막내 블로그 넣기",
    "default_icon": { "128": "icon128.png" }
  },
  "icons": { "128": "icon128.png" },
  "background": { "service_worker": "background.js" },
  "externally_connectable": {
    "matches": ["https://si0in.kr/*", "https://*.si0in.kr/*"]
  }
}
