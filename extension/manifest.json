{
  "manifest_version": 3,
  "name": "시공막내 — 네이버 블로그 넣기",
  "version": "0.18.0",
  "description": "시공막내에서 만든 글을 네이버 블로그 글쓰기 창에 자동으로 넣어줍니다(진짜 붙여넣기·서식까지).",
  "permissions": ["activeTab", "scripting", "clipboardWrite", "debugger", "storage", "downloads"],
  "host_permissions": ["https://blog.naver.com/*", "https://api.si0in.kr/*", "https://si0in.kr/*"],
  "action": {
    "default_title": "시공막내 블로그 넣기 (패널 열기/닫기)",
    "default_icon": { "128": "icon128.png" }
  },
  "icons": { "128": "icon128.png" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://blog.naver.com/*"],
      "js": ["format.js", "panel.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "externally_connectable": {
    "matches": ["https://si0in.kr/*", "https://*.si0in.kr/*"]
  }
}
