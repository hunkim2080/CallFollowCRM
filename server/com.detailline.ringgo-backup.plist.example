<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.detailline.ringgo-backup</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/hun/ringgo-server/backup_cache.sh</string>
  </array>

  <!-- 매일 새벽 4시 30분 (서버 한가한 시간) -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>4</integer>
    <key>Minute</key><integer>30</integer>
  </dict>

  <!-- 그 시간에 맥미니가 꺼져 있었으면 켜진 뒤 한 번 따라잡는다 -->
  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/hun/ringgo-backups/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/hun/ringgo-backups/launchd.err.log</string>

  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
</dict>
</plist>
